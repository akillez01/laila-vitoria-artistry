# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_PATH: caminho do arquivo SQLite (persistir fora de dist/ em produção).
DATABASE_PATH="./data/app.db"

# JWT_SECRET: segredo para assinar o cookie de sessão do admin. Gere um valor
# aleatório forte (ex: `openssl rand -hex 32`) e nunca reutilize entre ambientes.
JWT_SECRET="CHANGE_ME"

# Mercado Pago: credenciais do painel de desenvolvedores
# https://www.mercadopago.com.br/developers/panel/app (use TEST- em dev/staging).
MERCADOPAGO_ACCESS_TOKEN="MY_MERCADOPAGO_ACCESS_TOKEN"
MERCADOPAGO_PUBLIC_KEY="MY_MERCADOPAGO_PUBLIC_KEY"

# Pix estático: chave Pix do recebedor, usada para gerar QR Code "copia e cola"
# localmente (sem gateway/API externa).
PIX_KEY="MY_PIX_KEY"
PIX_MERCHANT_NAME="MY_STUDIO_NAME"
PIX_MERCHANT_CITY="MY_CITY"

# --- Produção na Vercel ---------------------------------------------------
# Turso (banco). Sem TURSO_DATABASE_URL o app usa o SQLite local em DATABASE_PATH.
# Crie em https://app.turso.tech → Create Database → copie a URL (libsql://...) e gere um token.
TURSO_DATABASE_URL="libsql://SEU-BANCO.turso.io"
TURSO_AUTH_TOKEN="MY_TURSO_TOKEN"

# Cloudflare R2 (fotos e vídeos). Dashboard Cloudflare → R2 → criar bucket e
# "Manage API Tokens" (permissão Object Read & Write no bucket).
R2_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
R2_BUCKET="laila-midia"
# Domínio público do bucket (ex: domínio personalizado midia.laylavitoria.com.br).
R2_PUBLIC_URL="https://midia.laylavitoria.com.br"
